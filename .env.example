# Public Supabase connection (safe for browser use; RLS must remain enabled)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# OAuth and canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CANONICAL_HOST=animefoodex.com
# Enable only after the custom domain is attached and every provider origin is updated.
ENFORCE_CANONICAL_HOST=false

# Moderation (server only)
OPENAI_API_KEY=

# Stripe (international billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Razorpay (India billing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_YEARLY_PLAN_ID=

# Ads — set to auto only after at least one provider approval and verified test ads
NEXT_PUBLIC_AD_PROVIDER=none
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_MEDIA_NET_CID=
NEXT_PUBLIC_INFOLINKS_PID=
# Keep false until the selected provider is verified to consume the approved CMP signal.
AD_CONSENT_SIGNAL_CONFIRMED=false
NEXT_PUBLIC_AD_SLOT_CATALOG=

# Operational safeguards
CRON_SECRET=
CONTENT_GATE_MODE=candidate
